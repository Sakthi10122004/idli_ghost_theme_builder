    /* Staggered delays for nav items */
    .gh-head-open #gh-head.gh-head .nav li:nth-child(1) { transition-delay: 0.05s !important; }
    .gh-head-open #gh-head.gh-head .nav li:nth-child(2) { transition-delay: 0.10s !important; }
