    /* SVG burger icon toggle */
    #gh-head.gh-head .gh-burger::before,
    #gh-head.gh-head .gh-burger::after {
      display: none !important;
    }
    .gh-head-open #gh-head.gh-head .gh-burger .burger-icon {
