
<style>
  #site-footer,
  footer#site-footer,
  .site-footer#site-footer {
    width: 100% !important;
    background-color: var(--color-bg);
    color: var(--color-fg) !important;
    padding-top: 40px !important;
    padding-bottom: 40px !important;
    padding-left: 24px !important;
    padding-right: 24px !important;
    max-width: 100% !important;
    margin-left: auto !important;
    margin-right: auto !important;
    box-sizing: border-box !important;
    
  }
  #site-footer a {
    color: inherit;
    text-decoration: none;
    transition: opacity 0.2s;
  }
  #site-footer a:hover {
    opacity: 0.7;
  }

  #site-footer .footer-social-links:empty,
  #site-footer .footer-secondary-nav:empty,
  #site-footer .footer-secondary-column:empty {
    display: none !important;
  }
  #site-footer .footer-social-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px 16px;
    max-width: 100%;
  }
  #site-footer .footer-social-links a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.2s;
  }
  #site-footer .footer-social-links a:hover {
    opacity: 1;
  }
  #site-footer .footer-social-links svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  /* Footer Navigation Columns (Multi-Column) */
  #site-footer .footer-nav-column .nav,
  #site-footer .footer-nav-column .nav-secondary {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  #site-footer .footer-nav-column .nav li,
  #site-footer .footer-nav-column .nav-secondary li {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  #site-footer .footer-nav-column .nav a,
  #site-footer .footer-nav-column .nav-secondary a {
    color: inherit;
    text-decoration: none;
    opacity: 0.8;
    font-size: 0.875rem;
    line-height: 1.5;
    transition: opacity 0.2s;
  }
  #site-footer .footer-nav-column .nav a:hover,
  #site-footer .footer-nav-column .nav-secondary a:hover {
    opacity: 1;
  }

  /* Footer Secondary Navigation (Horizontal row in bottom bar) */
  #site-footer .footer-secondary-nav,
  #site-footer .footer-secondary-nav .nav,
  #site-footer .footer-secondary-nav .nav-secondary,
  #site-footer .footer-bottom ul.nav,
  #site-footer .footer-bottom ul.nav-secondary {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 16px 24px;
  }
  #site-footer .footer-secondary-nav .nav li,
  #site-footer .footer-secondary-nav .nav-secondary li,
  #site-footer .footer-bottom ul.nav li,
  #site-footer .footer-bottom ul.nav-secondary li {
    list-style: none;
    margin: 0;
    padding: 0;
    display: inline-flex;
    align-items: center;
  }
  #site-footer .footer-secondary-nav .nav a,
  #site-footer .footer-secondary-nav .nav-secondary a,
  #site-footer .footer-bottom ul.nav a,
  #site-footer .footer-bottom ul.nav-secondary a {
    color: inherit;
    text-decoration: none;
    opacity: 0.8;
    font-size: 0.875rem;
    transition: opacity 0.2s;
  }
  #site-footer .footer-secondary-nav .nav a:hover,
  #site-footer .footer-secondary-nav .nav-secondary a:hover,
  #site-footer .footer-bottom ul.nav a:hover,
  #site-footer .footer-bottom ul.nav-secondary a:hover {
    opacity: 1;
  }

  html.dark #site-footer {
    background-color: var(--color-bg) !important;
    color: var(--color-fg) !important;
  }
  html.dark #site-footer .footer-subscribe-btn {
    background-color: var(--color-primary) !important;
    color: var(--color-on-primary) !important;
  }
  #site-footer .footer-inner {
    margin: 0 auto;
    max-width: 1024px;
    width: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  #site-footer .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    box-sizing: border-box;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  #site-footer .footer-copyright {
    opacity: 0.7;
    font-size: 0.875rem;
    text-align: left;
    flex-shrink: 0;
  }
  #site-footer .footer-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 24px;
  }
  @media (max-width: 767px) {
    #site-footer .footer-bottom {
      flex-direction: column !important;
      align-items: center !important;
      justify-content: center !important;
      text-align: center !important;
      gap: 20px !important;
    }
    #site-footer .footer-copyright {
      text-align: center !important;
      width: 100% !important;
    }
    #site-footer .footer-actions {
      justify-content: center !important;
      width: 100% !important;
    }
  }
</style>
<footer 
  id="site-footer" 
  class="site-footer section-width-full "
  style="width: 100%; background-color: var(--color-bg); color: var(--color-fg); padding-top: 40px; padding-bottom: 40px; padding-left: 24px; padding-right: 24px; max-width: 100%; margin-left: auto; margin-right: auto; box-sizing: border-box"
>
  <div class="gh-container footer-inner content-width-standard align-center" style="margin: 0 auto; max-width: 1024px; width: 100%; box-sizing: border-box; display: flex; flex-direction: column; gap: 32px;">
    
      <div class="footer-bottom" style="width: 100%; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 24px; font-size: 0.875rem; line-height: 1.5; box-sizing: border-box;">
        <div class="footer-copyright" style="opacity: 0.7; text-align: left; flex-shrink: 0; font-size: 0.875rem;">© 2026 Ghost Theme Builder. Published with Ghost.</div>
        <div class="footer-actions" style="display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 24px;">
          
          <nav class="footer-secondary-nav" aria-label="Secondary Navigation">
            {{#if @site.secondary_navigation}}
              {{navigation type="secondary"}}
            {{else}}
              <ul class="nav nav-secondary" role="menu">
                <li class="nav-privacy" role="menuitem"><a href="/privacy/">Privacy Policy</a></li>
                <li class="nav-terms" role="menuitem"><a href="/terms/">Terms of Service</a></li>
                <li class="nav-contact" role="menuitem"><a href="/contact/">Contact</a></li>
              </ul>
            {{/if}}
          </nav>
          
          
    <div class="footer-social-links" style="display: flex; flex-wrap: wrap; gap: 14px 16px; align-items: center; justify-content: center; max-width: 100%;">
      {{#if @site.facebook}}
        <a href="{{@site.facebook}}" target="_blank" rel="noopener" aria-label="Facebook" style="color: inherit; opacity: 0.8; transition: opacity 0.2s;">
          {{> "icons/facebook"}}
        </a>
      {{else}}
        <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook" style="color: inherit; opacity: 0.8; transition: opacity 0.2s;">
          {{> "icons/facebook"}}
        </a>
      {{/if}}
      {{#if @site.twitter}}
        <a href="{{@site.twitter}}" target="_blank" rel="noopener" aria-label="X" style="color: inherit; opacity: 0.8; transition: opacity 0.2s;">
          {{> "icons/x"}}
        </a>
      {{else}}
        <a href="https://twitter.com" target="_blank" rel="noopener" aria-label="X" style="color: inherit; opacity: 0.8; transition: opacity 0.2s;">
          {{> "icons/x"}}
        </a>
      {{/if}}
      <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram" style="color: inherit; opacity: 0.8; transition: opacity 0.2s;">
        {{> "icons/instagram"}}
      </a>
      <a href="https://linkedin.com" target="_blank" rel="noopener" aria-label="LinkedIn" style="color: inherit; opacity: 0.8; transition: opacity 0.2s;">
        {{> "icons/linkedin"}}
      </a>
    </div>
  
        </div>
      </div>
    
  </div>
</footer>