    #featured-posts-featured-posts-sec .featured-posts-masonry:has(> article:only-child) {
      column-count: unset;
      display: flex;
      justify-content: center;
    }
    #featured-posts-featured-posts-sec .featured-posts-masonry:has(> article:only-child) > article {
      width: 100%;
      max-width: 420px;
      margin-bottom: 0;
    }
    /* 2 posts: 2 columns, centered */
    #featured-posts-featured-posts-sec .featured-posts-masonry:has(> article:nth-child(2):last-child) {
      column-count: unset;
      display: flex;
      gap: 1.5rem;
      justify-content: center;
    }
    #featured-posts-featured-posts-sec .featured-posts-masonry:has(> article:nth-child(2):last-child) > article {
      width: 100%;
      max-width: 420px;
      margin-bottom: 0;
    }
  }
  #featured-posts-featured-posts-sec .featured-post-masonry-card {
    break-inside: avoid;
    margin-bottom: 1.5rem;
    background: var(--color-bg, #ffffff);
    border: 1px solid var(--color-border, #ebebeb);
    border-radius: 0.75rem;
    overflow: hidden;
  }
  #featured-posts-featured-posts-sec .featured-post-masonry-image {
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-canvas-soft, #fafafa);
  }
  #featured-posts-featured-posts-sec .featured-post-masonry-card:nth-child(3n+1) .featured-post-masonry-image {
    aspect-ratio: 1 / 1;
  }
  #featured-posts-featured-posts-sec .featured-post-masonry-card:nth-child(3n+2) .featured-post-masonry-image {
    aspect-ratio: 4 / 5;
  }
  #featured-posts-featured-posts-sec .featured-post-masonry-card:nth-child(3n+3) .featured-post-masonry-image {
    aspect-ratio: 16 / 9;
  }
  #featured-posts-featured-posts-sec .featured-post-masonry-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Auto Scroll Carousel */
  #featured-posts-featured-posts-sec .carousel-track-container {
    overflow: hidden;
    width: 100%;
    padding: 0.5rem 0;
  }
  #featured-posts-featured-posts-sec .carousel-track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
    animation: ghMarquee 25s linear infinite;
  }
  #featured-posts-featured-posts-sec .featured-posts-carousel-autoscroll:hover .carousel-track {
    animation-play-state: paused;
  }
  @keyframes ghMarquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  /* Auto Scroll Masonry */
  #featured-posts-featured-posts-sec .masonry-autoscroll-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
    height: 500px;
    overflow: hidden;
    width: 100%;
    box-sizing: border-box;
  }
  @media (min-width: 1024px) {
    #featured-posts-featured-posts-sec .masonry-autoscroll-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  #featured-posts-featured-posts-sec .masonry-column {
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  #featured-posts-featured-posts-sec .masonry-column-track {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  #featured-posts-featured-posts-sec .masonry-col-up .masonry-column-track {
    animation: ghScrollUp 30s linear infinite;
  }
  #featured-posts-featured-posts-sec .masonry-col-down .masonry-column-track {
    animation: ghScrollDown 30s linear infinite;
  }
  #featured-posts-featured-posts-sec .featured-posts-masonry-autoscroll:hover .masonry-column-track {
    animation-play-state: paused;
  }
  @keyframes ghScrollUp {
    0% { transform: translateY(0); }
    100% { transform: translateY(-50%); }
  }
  @keyframes ghScrollDown {
    0% { transform: translateY(-50%); }
    100% { transform: translateY(0); }
  }
  #featured-posts-featured-posts-sec .featured-posts-header {
    margin: 0 auto 3rem auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    width: 100%;
    max-width: 42rem;
    gap: 0.5rem;
  }
  #featured-posts-featured-posts-sec .featured-posts-title {
    font-family: var(--gh-font-heading, inherit);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-fg, #171717);
    line-height: 1.2;
    margin: 0;
    width: 100%;
    text-align: center;
  }
  #featured-posts-featured-posts-sec .featured-posts-description {
    font-size: 0.9375rem;
    color: var(--color-muted, #666666);
    line-height: 1.6;
    margin: 0;
    width: 100%;
    text-align: center;
  }
  #featured-posts-featured-posts-sec .featured-post-title,
  #featured-posts-featured-posts-sec .featured-post-title-main,
  #featured-posts-featured-posts-sec .featured-post-title-secondary,
  #featured-posts-featured-posts-sec .featured-post-title-list,
  #featured-posts-featured-posts-sec .featured-post-bento-title,
  #featured-posts-featured-posts-sec .featured-post-editorial-title {
    color: var(--color-fg, #171717);
  }
  #featured-posts-featured-posts-sec .featured-post-excerpt,
  #featured-posts-featured-posts-sec .featured-post-excerpt-main,
  #featured-posts-featured-posts-sec .featured-post-bento-excerpt {
    color: var(--color-muted, #4d4d4d);
  }
</style>
<div id="featured-posts-featured-posts-sec" class="featured-posts-container kg-width-full" style="padding-top: 64px; padding-bottom: 64px; background-color: var(--color-bg)">
  
  <div class="featured-posts-header">
    <h2 class="featured-posts-title">Featured Highlights</h2>
    <p class="featured-posts-description">Hand-picked stories and top editorial selections from our writers.</p>
  </div>
  
    <div class="featured-posts-split">
      {{#get "posts" filter="featured:true" limit="3"}}
      {{#foreach posts}}
        {{#if @first}}
          <article class="featured-post-main">
            <a class="featured-post-card-link" href="{{url}}">
              {{#if feature_image}}
                <div class="featured-post-image-main">
                  <img src="{{img_url feature_image size="m"}}" alt="{{title}}" loading="lazy" />
                </div>
              {{/if}}
              <div class="featured-post-content-main">
                {{#if primary_tag}}
                  <span class="featured-post-tag">{{primary_tag.name}}</span>
                {{/if}}
                <h3 class="featured-post-title-main">{{title}}</h3>
                {{#if excerpt}}
                  <p class="featured-post-excerpt-main">{{excerpt words="30"}}</p>
                {{/if}}
              </div>
            </a>
          </article>
          <div class="featured-posts-secondary-list">
        {{else}}
          <article class="featured-post-secondary">
            <a class="featured-post-secondary-link" href="{{url}}">
              {{#if feature_image}}
                <div class="featured-post-image-secondary">
                  <img src="{{img_url feature_image size="s"}}" alt="{{title}}" loading="lazy" />
                </div>
              {{/if}}
              <div class="featured-post-content-secondary">
                {{#if primary_tag}}
                  <span class="featured-post-tag">{{primary_tag.name}}</span>
                {{/if}}
                <h4 class="featured-post-title-secondary">{{title}}</h4>
              </div>
            </a>
          </article>
        {{/if}}
        {{#if @last}}
          </div>
        {{/if}}
      {{/foreach}}
      {{/get}}
    </div>
</div>
